# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Dùng dữ liệu/index thật sau khi chạy Task 4. Chỉ dùng mock để phát triển UI.
RAG_RETRIEVAL_MODE=real

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding local: không dùng API/quota, model đa ngôn ngữ hỗ trợ tiếng Việt.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
