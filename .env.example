# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Dùng dữ liệu/index thật sau khi chạy Task 4. Chỉ dùng mock để phát triển UI.
RAG_RETRIEVAL_MODE=real

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: gemini | openai | openrouter | sentence_transformers
# Gemini avoids downloading a local embedding model; it uses GEMINI_API_KEY above.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
